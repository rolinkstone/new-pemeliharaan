# ============================================
# CONTOH konfigurasi untuk docker-compose
# --------------------------------------------
# Cara pakai:
#   copy .env.example .env
#   lalu isi nilai sebenarnya.
# File `.env` SUDAH di-ignore oleh git — JANGAN di-commit.
# ============================================

# ---------- Database (backend) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pemeliharaan_aset_bpom
DB_PASSWORD=isi_password_database_di_sini
DB_NAME=pemeliharaan_aset_bpom

# ---------- Keycloak (server) ----------
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=isi_password_admin_keycloak

# ---------- Keycloak (client) ----------
KEYCLOAK_CLIENT_ID=pemeliharaan
KEYCLOAK_CLIENT_SECRET=isi_client_secret_keycloak

# ---------- NextAuth (frontend) ----------
NEXTAUTH_URL=https://tabela-raya.bbpompky.id
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=isi_random_secret_minimal_32_karakter

# ---------- Public (aman dibuka, bukan rahasia) ----------
NEXT_PUBLIC_API_URL=https://data-tabela.bbpompky.id/api
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=pemeliharaan
