# ============================================
# CONTOH konfigurasi backend
# Cara pakai: copy .env.example .env.local lalu isi nilai sebenarnya.
# File .env / .env.local JANGAN di-commit (sudah di-ignore).
# ============================================

# ---------- Database ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pemeliharaan_aset_bpom
DB_PASSWORD=isi_password_database_di_sini
DB_NAME=pemeliharaan_aset_bpom

# ---------- Keycloak ----------
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=nextjs-local
KEYCLOAK_CLIENT_SECRET=isi_client_secret_di_sini
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=isi_password_admin_di_sini

# ---------- Security ----------
# Generate dengan: openssl rand -hex 32
JWT_SECRET=isi_random_secret_minimal_32_karakter
SESSION_SECRET=isi_random_secret_minimal_32_karakter

# ---------- App ----------
NODE_ENV=development
PORT=5002
FRONTEND_URL=http://localhost:3003
CORS_ORIGIN=http://localhost:3003
