# ============================================
# CONTOH konfigurasi frontend
# Cara pakai: copy .env.example .env.local lalu isi nilai sebenarnya.
# File .env / .env.local JANGAN di-commit (sudah di-ignore).
# ============================================

# ---------- Backend API ----------
BASE_URL=http://localhost:5002
NEXT_PUBLIC_API_URL=http://localhost:5002/api

# ---------- Keycloak ----------
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=local-pemeliharaan
KEYCLOAK_CLIENT_SECRET=isi_client_secret_di_sini
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=isi_password_admin_di_sini

# ---------- NextAuth ----------
NEXTAUTH_URL=http://localhost:3003
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=isi_random_secret_minimal_32_karakter

# ---------- Public (aman dibuka, bukan rahasia) ----------
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=pemeliharaan
